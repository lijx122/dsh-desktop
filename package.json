{
  "name": "dsh-desktop",
  "version": "1.2.0",
  "description": "DeepSeek Harness (DSH) All-in-One Standalone Desktop Client",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win dir",
    "dist:exe": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "electron",
    "standalone",
    "all-in-one"
  ],
  "author": "DSH Community",
  "license": "MIT",
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.deepseek.dsh.desktop",
    "productName": "DeepSeek Harness",
    "win": {
      "target": [
        "dir"
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "${productName}-AllInOne-v${version}.${ext}"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
